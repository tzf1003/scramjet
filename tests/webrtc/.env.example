# Copy to tests/webrtc/.env and replace the secret. Never commit .env.
# Generate one with: openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=replace-with-a-random-shared-secret
TURN_REALM=scramjet.webrtc
TURN_EXTERNAL_IP=127.0.0.1/172.29.0.10
# Comma-separated IPs the test peers bind on. Keep empty for public-only production.
TURN_ALLOWED_PEER_IP=
TURN_URLS=turn:127.0.0.1:13478?transport=udp,turn:127.0.0.1:13478?transport=tcp,turns:127.0.0.1:15349?transport=tcp
TURN_TTL=3600
# Optional CORS origin when the credential endpoint is not same-origin.
ALLOWED_ORIGIN=
