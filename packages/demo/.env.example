VITE_PROXY_DOMAIN=xs2api.com
VITE_GATEWAY_HOST=my.xs2api.com
# Default: ws(s)://<current proxy host>/wisp/
# VITE_WISP_URL=wss://your-wisp-server.example/wisp/
# Enable the production access gateway and its TURN configuration.
# VITE_GATEWAY_ACCESS=1
# Serve the large static files from one shared host (see deployment/README.md)
# so every proxied hostname reuses the same browser cache entries.
# VITE_ASSET_ORIGIN=https://assets.xs2api.com
